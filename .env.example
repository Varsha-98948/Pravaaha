# ==============================================================================
# ReRoute Environment Configuration (.env.example)
# Copy this file to .env and configure your secrets.
# Never commit real API keys or credentials to Git.
# ==============================================================================

# AI Provider Selection
# Set to 'openrouter' to enable OpenRouter with automatic 3-key failover and free-only models.
AI_PROVIDER=openrouter

# OpenRouter 3-Key Slots (Three Independent Accounts)
# Configure three separate API keys for accounts 1, 2, and 3.
# The system automatically rotates requests fairly and fails over when a key is
# rate-limited, runs out of credits, or encounters a temporary restriction.
OPENROUTER_API_KEY_1=sk-or-v1-367...de4
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# OpenRouter Strict Free-Only Model Policy
# Only approved zero-priced models from the verified OpenRouter catalog are permitted.
# Paid models and paid fallbacks are strictly rejected by the backend.
OPENROUTER_FREE_MODEL=apodex/apodex-1.1-mini:free
OPENROUTER_FREE_MODEL_ALLOWLIST=apodex/apodex-1.1-mini:free,openrouter/free
OPENROUTER_PAID_FALLBACK_ENABLED=false

# Optional OpenRouter Endpoint Override (defaults to https://openrouter.ai/api/v1/chat/completions)
OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# AI Request Timeout in milliseconds (default: 15000)
AI_TIMEOUT_MS=15000

# Alternative Direct Providers (Optional fallbacks)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Supabase Configuration (Leave empty for Demo Mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
