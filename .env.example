# =============================================================================
# Pravaaha ReRoute Environment Configuration
# =============================================================================

# Client-Side Database (Supabase) - Optional
# Leave empty to run the UI in demo mode with in-memory state.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================================================
# Backend AI Disruption Interpreter (Secure - Server/Vite Only)
# =============================================================================
# IMPORTANT: These variables are NEVER prefixed with VITE_, which ensures they
# are loaded strictly in Node.js server processes and never exposed to the browser.

# 1. Primary AI Provider Setup (Default: Google Gemini)
# Provider options: 'gemini' | 'openai' | 'groq' | 'anthropic'
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Optional request timeout in milliseconds (default: 15000)
AI_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Alternative Provider-Specific Configurations (auto-detected if AI_API_KEY is omitted):
# -----------------------------------------------------------------------------
# Google Gemini:
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Groq:
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Custom OpenAI-Compatible Base URL (e.g., Local Ollama or proxy):
# AI_API_ENDPOINT=http://localhost:11434/v1/chat/completions
